{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "api:types": "openapi-typescript ../api/openapi.yaml -o src/shared/api/schema.gen.ts",
    "shots": "node scripts/screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:styles": "stylelint --allow-empty-input \"src/**/*.css\"",
    "lint:fsd": "steiger ./src",
    "format": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm api:types && git diff --exit-code -- src/shared/api/schema.gen.ts && pnpm typecheck && pnpm lint && pnpm lint:styles && pnpm lint:fsd && pnpm format && pnpm test && pnpm build && pnpm audit --prod"
  },
  "dependencies": {
    "@fontsource/onest": "5.3.1",
    "@mantine/core": "9.7.3",
    "@mantine/form": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "postcss-preset-mantine": "1.18.0",
    "prettier": "3.9.10",
    "steiger": "0.8.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
