# Скопируйте в .env (cp .env.example .env) и задайте значения. .env в git не попадает.
# Случайный пароль или токен: openssl rand -hex 16

# Пароль базы (используется Compose и для DATABASE_URL приложения)
POSTGRES_PASSWORD=

# Администратор из окружения. Пустой ADMIN_PASSWORD — приложение не стартует.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Демо-учётки для жюри и маркетолога/аналитика (пустой пароль — учётка не создаётся)
DEMO_MARKETER_PASSWORD=
DEMO_ANALYST_PASSWORD=
DEMO_JURY_PASSWORD=

# Токены: /metrics и приём снимка источника
METRICS_TOKEN=
SOURCE_TOKEN=

# Вход через SSO (Keycloak, профиль Compose `sso`). Пустой OIDC_ISSUER_URL — кнопка SSO выключена.
# Случайные значения: openssl rand -hex 16
OIDC_ISSUER_URL=
# Адрес, по которому приложение читает discovery, если он отличается от публичного
# (в Compose: http://keycloak:8080/sso/realms/churn).
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=panel
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
KC_ADMIN_PASSWORD=
KC_SECURE_PASSWORD=
# обязателен для профиля sso (openssl rand -hex 16): пустой секрет сделает второй фактор формальностью
KC_SECURE_TOTP_SECRET=

SEED_ORGANIZERS=true
SEED_STAND=false
# Опрос REST-биллинга: пусто — выключен. На стенде с профилем billing (COMPOSE_PROFILES=billing):
# BILLING_URL=http://mock-billing:8081/snapshot.json
BILLING_URL=
BILLING_TOKEN=
BILLING_POLL_SECONDS=60
SNAPSHOT_MAX_BYTES=536870912
# Как часто пересчёт делается целиком, даже если события частичные (формат 60s); 0 — всегда целиком.
RECALC_FULL_EVERY=60s
COOKIE_SECURE=false
TRUSTED_PROXY=false
HTTP_ADDR=:8080

# Только для запуска бинаря вне Compose (в Compose собирается из POSTGRES_PASSWORD):
# DATABASE_URL=postgres://app:<пароль>@localhost:5432/app?sslmode=disable
