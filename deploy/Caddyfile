# TLS-сертификат Let's Encrypt Caddy получает и продлевает сам.
# http:// автоматически перенаправляется на https://.
{$PROD_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Keycloak (профиль sso). Админка и master-realm снаружи закрыты.
	@kcadmin path /sso/admin /sso/admin/* /sso/realms/master /sso/realms/master/*
	handle @kcadmin {
		respond "Not Found" 404
	}
	handle /sso/* {
		reverse_proxy keycloak:8080
	}

	# Мониторинг: вход и пароли — в самой Grafana.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	handle {
		# Живые обновления (SSE) не буферизуем.
		@sse path /api/v1/events
		reverse_proxy @sse app:8080 {
			flush_interval -1
		}
		reverse_proxy app:8080
	}
}
